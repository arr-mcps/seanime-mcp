# Base URL of your Seanime instance (no trailing /api/v1; the server appends it)
SEANIME_URL=http://10.10.10.30:43211

# Auth token sent as X-Seanime-Token. This is the SHA256 hex of the server
# password (Seanime compares the header against its password hash). Leave
# empty only if the server password is unset.
SEANIME_API_KEY=
